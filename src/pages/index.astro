---
const title = "Bastión Defensa | Vigilancia de ciberseguridad para PYMEs en Albacete y España";
const description = "Vigilo tu servidor y tus equipos, también los fines de semana. Chequeo de 14 días por 900€ + IVA. Trato directo con el ingeniero, sin comerciales.";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="keywords" content="ciberseguridad Albacete, seguridad informática España, vigilancia ciberseguridad PYME, chequeo de seguridad informática, continuidad operativa, Wazuh, bastión defensa"/>
  <meta name="author" content="Bastión Defensa"/>
  <meta name="robots" content="index, follow"/>
  <link rel="canonical" href="https://www.bastiondefensa.com/"/>

  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content="https://www.bastiondefensa.com/"/>
  <meta property="og:locale" content="es_ES"/>
  <meta property="og:image" content="https://www.bastiondefensa.com/og-bastion.png" />

  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="https://www.bastiondefensa.com/" />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content="https://www.bastiondefensa.com/og-bastion.png" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Bastión Defensa",
    "description": "Vigilancia de ciberseguridad para PYMEs, incluidos fines de semana y festivos. Chequeo de 14 días, vigilancia continua y trato directo con el ingeniero. Albacete y toda España.",
    "url": "https://www.bastiondefensa.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Albacete",
      "addressRegion": "Castilla-La Mancha",
      "addressCountry": "ES"
    },
    "areaServed": [
      {"@type": "City", "name": "Albacete"},
      {"@type": "Country", "name": "España"}
    ],
    "serviceType": ["Vigilancia de Ciberseguridad para PYMEs", "Chequeo de Seguridad Informática"],
    "founder": {"@type": "Person", "name": "Mario"},
    "sameAs": ["https://linkedin.com/in/mario-munoza"]
  }
  </script>

  <style>
    @font-face {
      font-family: 'Plus Jakarta Sans';
      font-style: normal;
      font-weight: 400 800;
      font-display: swap;
      src: url('/fonts/PlusJakartaSans-Variable.woff2') format('woff2');
    }
    @font-face {
      font-family: 'IBM Plex Mono';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('/fonts/IBMPlexMono-Regular.woff2') format('woff2');
    }
    @font-face {
      font-family: 'IBM Plex Mono';
      font-style: normal;
      font-weight: 500;
      font-display: swap;
      src: url('/fonts/IBMPlexMono-Medium.woff2') format('woff2');
    }

    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

    :root {
      --navy: #0f1d3a;
      --navy-mid: #162347;
      --navy-light: #1c2d58;
      --slate: #2a3a5c;
      --sky: #e8eef6;
      --sky-warm: #f4f6fa;
      --white: #ffffff;
      --teal: #0d9488;
      --teal-light: #14b8a6;
      --teal-bg: rgba(13,148,136,.08);
      --teal-border: rgba(13,148,136,.2);
      --amber: #f59e0b;
      --amber-bg: rgba(245,158,11,.1);
      --coral: #b4382e;
      --coral-bg: rgba(180,56,46,.08);
      --coral-light: #ff8a73;
      --coral-glow: rgba(255,107,84,.14);
      --coral-line: rgba(255,138,115,.32);
      --line-dark: rgba(255,255,255,.1);
      --shadow-xl: 0 24px 60px rgba(15,29,58,.28), 0 4px 14px rgba(15,29,58,.12);
      --text-dark: #1a2740;
      --text: #475569;
      --text-light: #94a3b8;
      --border: #e2e8f0;
      --shadow-sm: 0 1px 3px rgba(15,29,58,.06);
      --shadow-md: 0 4px 20px rgba(15,29,58,.08);
      --shadow-lg: 0 8px 40px rgba(15,29,58,.12);
      --font: 'Plus Jakarta Sans', sans-serif;
      --mono: 'IBM Plex Mono', monospace;
      --radius: 14px;
      --nav-h: 87px;
    }

    html { scroll-behavior: smooth; scroll-padding-top: calc(var(--nav-h) - 8px); }
    body {
      background: var(--white);
      color: var(--text);
      font-family: var(--font);
      line-height: 1.7;
      overflow-x: hidden;
    }
    a { color: var(--teal); text-decoration: none; }

    /* NAV */
    nav {
      position: fixed; top:0; left:0; right:0; z-index:100;
      background: rgba(255,255,255,.88);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      padding: 0 2rem;
    }
    .nav-inner {
      max-width: 1140px; margin:0 auto;
      display: flex; align-items:center; justify-content:space-between;
      height: calc(var(--nav-h) - 1px);
    }
    .logo {
      display: flex; align-items:center; text-decoration: none;
    }
    .logo-img {
      height: 68px;
      width: auto;
      display: block;
      padding: 4px 0;
    }
    @media (max-width: 768px) {
      :root { --nav-h: 85px; }
      .logo-img {
        height: 68px;
      }
    }
    .nav-links { display:flex; gap:2rem; list-style:none; align-items:center;}
    .nav-links a { color: var(--text); font-size:.9rem; font-weight:500; transition: color .2s; }
    .nav-links a:hover { color: var(--teal); }
    .nav-cta {
      background: var(--navy) !important;
      color: var(--white) !important;
      padding: .55rem 1.3rem !important;
      border-radius: 9px;
      font-size: .85rem !important;
      font-weight: 600 !important;
      transition: all .25s;
    }
    .nav-cta:hover { background: var(--navy-mid) !important; transform:translateY(-1px); box-shadow: var(--shadow-md); }

    .hamburger { display:none; background:none; border:none; cursor:pointer; padding:4px; }
    .hamburger svg { stroke: var(--navy); }

    /* HERO */
    .hero {
      padding: 10rem 2rem 6rem;
      background: linear-gradient(170deg, var(--sky-warm) 0%, var(--white) 55%);
      position: relative; overflow: hidden;
    }
    .hero::before {
      content:''; position:absolute; top:-120px; right:-80px;
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(13,148,136,.07) 0%, transparent 70%);
      pointer-events:none;
    }
    .hero-inner {
      max-width: 1140px; margin:0 auto;
      display: grid; grid-template-columns: 1fr 400px; gap: 4rem; align-items: center;
    }
    .hero-badge {
      display: inline-flex; align-items:center; gap:.5rem;
      background: var(--teal-bg); border: 1px solid var(--teal-border);
      color: var(--teal); font-size: .78rem; font-weight: 600;
      padding: .4rem 1rem; border-radius: 100px; margin-bottom: 1.5rem;
      animation: fadeUp .7s ease both;
    }
    .hero-badge svg { width:14px; height:14px; }
    h1 {
      font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 800;
      color: var(--text-dark); line-height: 1.15; margin-bottom: 1.3rem;
      animation: fadeUp .7s ease .1s both;
    }
    h1 span { color: var(--teal); }
    .hero-sub {
      font-size: 1.1rem; color: var(--text); max-width: 500px;
      margin-bottom: 1rem; animation: fadeUp .7s ease .2s both;
    }
    .hero-note {
      font-family: var(--mono); font-size: .82rem; color: var(--text-light);
      border-left: 3px solid var(--teal); padding-left: 1rem;
      margin-bottom: 2rem; animation: fadeUp .7s ease .3s both;
    }
    .hero-btns { display:flex; gap:1rem; flex-wrap:wrap; animation: fadeUp .7s ease .4s both; }

    /* HERO · AVISO */
    .aviso-wrap { position: relative; animation: fadeUp .7s ease .3s both; }
    .aviso-caption { font-family: var(--mono); font-size: .72rem; letter-spacing: 1.2px; text-transform: uppercase; color: var(--text-light); margin: 0 0 .7rem .2rem; }
    .aviso-card { position: relative; overflow: hidden; background: linear-gradient(160deg, var(--navy-light) 0%, var(--navy) 60%); border: 1px solid var(--line-dark); border-radius: 18px; box-shadow: var(--shadow-xl); padding: 1.5rem 1.6rem 1.6rem; color: var(--white); }
    .aviso-card::after { content: ''; position: absolute; top: -90px; right: -90px; width: 220px; height: 220px; background: radial-gradient(circle, var(--coral-glow) 0%, transparent 70%); pointer-events: none; }
    .aviso-head { display: flex; align-items: center; gap: .8rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--line-dark); margin-bottom: 1.3rem; }
    .aviso-avatar { width: 40px; height: 40px; flex-shrink: 0; border-radius: 50%; background: var(--teal); color: var(--white); font-weight: 800; font-size: 1rem; display: flex; align-items: center; justify-content: center; }
    .aviso-from { flex: 1; min-width: 0; line-height: 1.35; }
    .aviso-from strong { display: block; color: var(--white); font-size: .92rem; font-weight: 700; }
    .aviso-from span { font-size: .78rem; color: var(--text-light); }
    .aviso-time { font-family: var(--mono); font-size: .8rem; color: var(--text-light); white-space: nowrap; }
    .aviso-badge { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--mono); font-size: .72rem; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; color: var(--coral-light); background: var(--coral-glow); border: 1px solid var(--coral-line); padding: .3rem .8rem; border-radius: 100px; margin-bottom: 1rem; }
    .aviso-dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--coral-light); }
    .aviso-dot::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--coral-light); animation: avisoPulse 1.8s ease-out infinite; }
    @keyframes avisoPulse { from { transform: scale(1); opacity: .7; } to { transform: scale(3); opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .aviso-dot::after { animation: none; } }
    .aviso-title { color: var(--white); font-weight: 800; font-size: 1.45rem; line-height: 1.25; margin-bottom: 1rem; letter-spacing: -.2px; }
    .aviso-title time { font-family: var(--mono); font-weight: 500; color: var(--coral-light); white-space: nowrap; }
    .aviso-body { font-size: .95rem; line-height: 1.6; color: var(--sky); }
    .aviso-body p { margin-bottom: .35rem; }
    .aviso-body ol { padding-left: 1.25rem; }
    .aviso-body li { padding-left: .2rem; }
    .aviso-body li::marker { color: var(--text-light); }

    /* BUTTONS */
    .btn {
      display: inline-flex; align-items:center; gap:.5rem;
      font-family: var(--font); font-weight: 700; font-size: .9rem;
      padding: .85rem 1.8rem; border-radius: 10px;
      transition: all .25s; cursor: pointer; border: none;
    }
    .btn-primary {
      background: var(--teal); color: var(--white);
      box-shadow: 0 2px 12px rgba(13,148,136,.25);
    }
    .btn-primary:hover {
      background: var(--teal-light); transform: translateY(-2px);
      box-shadow: 0 6px 24px rgba(13,148,136,.3);
    }
    .btn-outline {
      background: transparent; color: var(--navy);
      border: 1.5px solid var(--border);
    }
    .btn-outline:hover {
      border-color: var(--teal-border); background: var(--teal-bg); color: var(--teal);
    }

    /* SECTIONS */
    section { padding: 6rem 2rem; }
    .container { max-width: 1140px; margin: 0 auto; }
    .section-label {
      font-size: .75rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 2px; color: var(--teal); margin-bottom: .6rem;
    }
    h2 {
      font-size: clamp(1.6rem, 3.2vw, 2.3rem); font-weight: 800;
      color: var(--text-dark); line-height: 1.2; margin-bottom: .75rem;
    }
    .section-desc { color: var(--text); max-width: 560px; font-size: 1rem; margin-bottom: 3rem; }

    /* PRECIO (bloque reutilizable, chequeo y vigilancia) */
    .price-block {
      margin: 1.5rem 0 2.5rem;
      padding: 1.4rem 2rem;
      background: var(--navy);
      border-radius: var(--radius);
      box-shadow: none;
      cursor: default;
      max-width: 560px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: .7rem;
    }
    .price-figure {
      font-family: var(--mono);
      font-size: 1.9rem;
      font-weight: 700;
      color: var(--white);
      line-height: 1.2;
      margin: 0;
    }
    .price-vat {
      font-family: var(--font);
      font-size: .82rem;
      font-weight: 500;
      color: rgba(255,255,255,.6);
      margin-left: .4rem;
    }
    .price-right { width: 100%; text-align: left; }
    .price-includes {
      font-size: .82rem;
      color: rgba(255,255,255,.65);
      line-height: 1.5;
      margin: 0;
    }
    .price-includes + .price-includes { margin-top: .25rem; }
    @media (max-width: 640px) {
      .price-block { padding: 1.3rem 1.5rem; }
      .price-figure { font-size: 1.6rem; }
    }

    /* CHEQUEO */
    .chequeo { background: var(--sky-warm); }
    .chequeo .section-desc { margin-bottom: 1.5rem; }
    .incluye-block { margin-top: 3rem; max-width: 560px; }
    .incluye-title { font-size: 1.05rem; font-weight: 700; color: var(--text-dark); margin-bottom: 1rem; }
    .incluye-list { list-style: none; padding: 0; margin-bottom: 1.5rem; }
    .incluye-list li {
      position: relative;
      padding-left: 1.6rem;
      margin-bottom: .7rem;
      font-size: .92rem;
      color: var(--text);
      line-height: 1.5;
    }
    .incluye-list li::before {
      content: '✓';
      position: absolute;
      left: 0; top: 0;
      color: var(--teal);
      font-weight: 700;
    }
    .incluye-descuento {
      font-family: var(--mono);
      font-size: .85rem;
      color: var(--teal);
      background: var(--teal-bg);
      border-left: 3px solid var(--teal);
      padding: .8rem 1rem;
      border-radius: 0 8px 8px 0;
    }

    /* SERVICIOS */
    .svc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5rem; }
    .svc-card {
      background: var(--white); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 2.2rem 1.8rem;
      transition: all .3s; position: relative;
    }
    .svc-card:hover { border-color: var(--teal-border); box-shadow: var(--shadow-md); transform: translateY(-4px); }
    .svc-num { font-family: var(--mono); font-size: .7rem; color: var(--text-light); margin-bottom: 1rem; }
    .svc-icon {
      width: 48px; height: 48px; border-radius: 12px;
      display: flex; align-items:center; justify-content:center; margin-bottom: 1.3rem;
    }
    .svc-icon.shield { background: var(--teal-bg); color: var(--teal); }
    .svc-card h3 { font-size: 1.08rem; font-weight: 700; color: var(--text-dark); margin-bottom: .7rem; }
    .svc-card p { font-size: .88rem; color: var(--text); line-height: 1.65; }
    .svc-tag {
      display: inline-block; font-family: var(--mono); font-size: .68rem; font-weight: 500;
      color: var(--teal); background: var(--teal-bg);
      padding: .2rem .65rem; border-radius: 5px; margin-top: 1.1rem;
    }

    /* VIGILANCIA */
    .vigilancia { background: var(--sky-warm); }
    .vigilancia .section-desc { margin-bottom: 1.5rem; }
    .plazos-aviso {
      margin-top: 1.5rem;
      font-family: var(--mono);
      font-size: .85rem;
      color: var(--text-light);
      border-left: 3px solid var(--teal);
      padding-left: 1rem;
      max-width: 640px;
    }

    /* POR QUÉ */
    .porque-intro { max-width: 640px; margin-bottom: 3rem; }
    .porque-intro p { font-size: 1.02rem; margin-bottom: 1rem; }

    .porque-table-wrap {
      overflow-x: auto;
      margin-bottom: 3rem;
      -webkit-overflow-scrolling: touch;
    }
    .porque-table {
      width: 100%;
      border-collapse: collapse;
      font-size: .92rem;
    }
    .porque-table th, .porque-table td {
      padding: 1rem 1.2rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }
    .porque-table th {
      font-family: var(--mono);
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-light);
      font-weight: 600;
    }
    .porque-table td:first-child {
      font-weight: 700;
      color: var(--text-dark);
      white-space: nowrap;
    }
    .porque-table td:nth-child(2) { color: var(--text-light); }
    .porque-table td:nth-child(3) {
      color: var(--teal);
      font-weight: 600;
      background: var(--teal-bg);
    }

    .porque-objecion {
      background: var(--sky-warm);
      border-radius: var(--radius);
      padding: 2rem 2.2rem;
      max-width: 640px;
    }
    .porque-objecion h3 { font-size: 1.05rem; color: var(--text-dark); margin-bottom: .6rem; }
    .porque-objecion p { font-size: .92rem; color: var(--text); margin: 0; }

    @media (max-width: 640px) {
      .porque-table { font-size: .82rem; }
      .porque-table th, .porque-table td { padding: .7rem .5rem; }
      .porque-table td:first-child { white-space: normal; }
      .porque-objecion { padding: 1.6rem; }
    }

    /* PREGUNTAS */
    .faq-list { max-width: 760px; }
    .faq-item {
      border-bottom: 1px solid var(--border);
      padding: 1.4rem 0;
    }
    .faq-item summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      cursor: pointer;
      font-weight: 700;
      color: var(--text-dark);
      font-size: 1rem;
      list-style: none;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::marker { content: ''; }
    .faq-icon {
      position: relative;
      flex-shrink: 0;
      width: 20px;
      height: 20px;
    }
    .faq-icon::before, .faq-icon::after {
      content: '';
      position: absolute;
      background: var(--teal);
      transition: transform .25s ease;
    }
    .faq-icon::before {
      top: 50%; left: 0;
      width: 100%; height: 2px;
      transform: translateY(-50%);
    }
    .faq-icon::after {
      left: 50%; top: 0;
      width: 2px; height: 100%;
      transform: translateX(-50%);
    }
    .faq-item[open] .faq-icon::after { transform: translateX(-50%) scaleY(0); }
    .faq-item p {
      margin-top: 1rem;
      color: var(--text);
      font-size: .95rem;
      line-height: 1.65;
      max-width: 620px;
    }

    /* MARIO */
    .mario-section { background: var(--navy); color: rgba(255,255,255,.7); }
    .mario-grid { display: grid; grid-template-columns: auto 1fr; gap: 3.5rem; align-items: center; }
    .mario-avatar {
      width: 150px; height: 150px;
      background: linear-gradient(135deg, rgba(13,148,136,.25), rgba(13,148,136,.05));
      border: 2px solid rgba(13,148,136,.3); border-radius: 50%;
      display: flex; align-items:center; justify-content:center;
      font-size: 3.2rem; font-weight: 800; color: var(--teal-light);
    }
    .mario-section .section-label { color: var(--teal-light); }
    .mario-section h2 { color: var(--white); }
    .mario-role { font-family: var(--mono); font-size: .82rem; color: var(--teal-light); margin-bottom: 1.2rem; }
    .mario-section p { margin-bottom: .8rem; }

    /* CTA */
    .cta-section { background: var(--sky-warm); text-align:center; }
    .cta-box {
      background: var(--white); border: 1px solid var(--border);
      border-radius: 20px; padding: 4rem 2rem; max-width: 680px;
      margin: 0 auto; box-shadow: var(--shadow-md);
    }
    .cta-box h2 { margin-bottom: .6rem; }
    .cta-box > p { color: var(--text); margin-bottom: 2rem; }
    .cta-btns { display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; }
    .cta-footnote { margin-top: 1.5rem; font-size: .82rem; color: var(--text-light); }
    .cta-footnote a { color: var(--text-light); text-decoration: underline; }
    .cta-footnote a:hover { color: var(--teal); }

    .local-section { text-align: center; padding: 4rem 2rem; }
    .local-section p { color: var(--text-light); font-size: .92rem; max-width: 600px; margin: 0 auto; }

    footer {
      border-top: 1px solid var(--border); padding: 2.5rem 2rem;
      display: flex; justify-content:space-between; align-items:center;
      max-width: 1140px; margin: 0 auto; flex-wrap: wrap; gap: 1rem;
    }
    footer p { font-size:.8rem; color:var(--text-light); }
    .footer-logo { font-weight:800; color:var(--navy); font-size:.95rem; }

    @keyframes fadeUp {
      from { opacity:0; transform:translateY(22px); }
      to { opacity:1; transform:translateY(0); }
    }
    .fade-in { opacity: 0; transform: translateY(24px); transition: opacity .55s ease, transform .55s ease; }
    .fade-in.visible { opacity:1; transform:translateY(0); }

    @media (max-width: 960px) {
      .hero-inner { grid-template-columns:1fr; }
      .aviso-wrap { max-width: 420px; }
      .svc-grid { grid-template-columns:1fr; max-width:480px; }
      .mario-grid { grid-template-columns:1fr; text-align:center; justify-items:center; }
    }
    @media (max-width: 640px) {
      .nav-links { display:none; }
      .hamburger { display:block; }
      .nav-links.open {
        display:flex; flex-direction:column;
        position:absolute; top:calc(var(--nav-h) - 1px); left:0; right:0;
        background: rgba(255,255,255,.97); backdrop-filter: blur(20px);
        padding: 1.5rem 2rem; border-bottom: 1px solid var(--border); gap: 1rem;
      }
      section { padding: 4rem 1.2rem; }
      .hero { padding: calc(var(--nav-h) + 1rem) 1.2rem 4rem; }
      .hero-text {
        min-height: calc(100vh - var(--nav-h) - 1rem);
        min-height: calc(100svh - var(--nav-h) - 1rem);
        display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
        padding-bottom: 1rem;
      }
      .aviso-card { padding: 1.3rem 1.2rem; }
      .aviso-title { font-size: 1.3rem; }
      .cta-box { padding: 2.5rem 1.5rem; }
      footer { flex-direction:column; text-align:center; }
    }
    @media (max-width: 640px) and (max-height: 620px) {
      .hero-badge { margin-bottom: 1rem; }
      h1 { font-size: 2rem; margin-bottom: 1rem; }
      .hero-sub { margin-bottom: .7rem; }
      .hero-note { margin-bottom: 1.2rem; }
    }

    .btn-flotante-icono {
      position: fixed;
      bottom: 2rem;       
      right: 2rem;        
      z-index: 9999;      
      
      display: flex;
      align-items: center;
      justify-content: center;
      
      width: 56px;
      height: 56px;
      border-radius: 50%; 
      
      background-color: var(--teal-light, #00b4d8); 
      color: #0a192f;     
      
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.1);
      
      cursor: pointer;

      /* La animación se encarga de cambiar la opacidad a 1 y dejarla fija */
      animation: entradaSuave 0.6s ease-out 0.8s forwards; 
      
      transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    }

    /* Animación de aparición (se queda igual) */
    @keyframes entradaSuave {
      from {
        opacity: 0;
        transform: translateY(15px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Efecto Hover (se queda igual) */
    .btn-flotante-icono:hover {
      transform: scale(1.1) translateY(-2px); 
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
    }

    /* Ajuste fino para móviles (se queda igual) */
    @media (max-width: 768px) {
      .btn-flotante-icono {
        bottom: 1.5rem;
        right: 1.5rem;
        width: 48px;
        height: 48px;
      }
    }

    /* HISTORIA - PUNTO CIEGO */
    .historia { background: var(--white); }
    .historia-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      margin-top: 2.5rem;
    }
    .historia-col {
      border-radius: var(--radius);
      padding: 2.5rem;
      position: relative;
      overflow: hidden;
    }
    .historia-col--danger {
      background: linear-gradient(135deg, var(--coral-bg) 0%, rgba(180,56,46,.02) 100%);
      border: 1.5px solid rgba(180,56,46,.25);
    }
    .historia-col--safe {
      background: linear-gradient(135deg, var(--teal-bg) 0%, rgba(13,148,136,.03) 100%);
      border: 1.5px solid var(--teal-border);
    }
    .historia-col-label {
      font-family: var(--mono);
      font-size: .75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 2rem;
      display: flex;
      align-items: center;
      gap: .6rem;
    }
    .historia-col--danger .historia-col-label {
      color: var(--coral);
    }
    .historia-col--safe .historia-col-label {
      color: var(--teal);
    }

    .historia-timeline {
      list-style: none;
      position: relative;
      padding: 0;
    }
    .historia-timeline::before {
      content: '';
      position: absolute;
      left: 11px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, rgba(180,56,46,.3), rgba(180,56,46,.05));
    }
    .historia-col--safe .historia-timeline::before {
      background: linear-gradient(to bottom, var(--teal-light), rgba(13,148,136,.1));
    }

    .historia-step {
      position: relative;
      padding-left: 48px;
      margin-bottom: 2.2rem;
      animation: slideInStep .6s ease-out backwards;
    }
    .historia-step:nth-child(1) { animation-delay: 0.1s; }
    .historia-step:nth-child(2) { animation-delay: 0.2s; }
    .historia-step:nth-child(3) { animation-delay: 0.3s; }
    .historia-step:nth-child(4) { animation-delay: 0.4s; }

    @keyframes slideInStep {
      from {
        opacity: 0;
        transform: translateX(-16px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .historia-dot {
      position: absolute;
      left: 0;
      top: 3px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--white);
      border: 2px solid var(--coral);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      transition: all .3s ease;
    }
    .historia-col--safe .historia-dot {
      border-color: var(--teal-light);
    }
    .historia-dot::after {
      content: '';
      position: absolute;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--coral);
    }
    .historia-col--safe .historia-dot::after {
      background: var(--teal-light);
    }
    .historia-dot--end {
      width: 28px;
      height: 28px;
      left: -2px;
      top: 0px;
    }
    .historia-dot--end::after {
      width: 12px;
      height: 12px;
    }

    .historia-time {
      font-family: var(--mono);
      font-size: .82rem;
      font-weight: 600;
      margin-bottom: .4rem;
      color: var(--text-dark);
    }
    .historia-col--danger .historia-time {
      color: var(--coral);
    }
    .historia-col--safe .historia-time {
      color: var(--teal);
    }

    .historia-text {
      font-size: .92rem;
      color: var(--text);
      line-height: 1.6;
      margin: 0;
    }
    .historia-text--end {
      font-weight: 700;
      color: var(--text-dark);
    }

    /* HOVER */
    .historia-step:hover .historia-dot {
      transform: scale(1.2);
      box-shadow: 0 0 12px rgba(180,56,46,.3);
    }
    .historia-col--safe .historia-step:hover .historia-dot {
      box-shadow: 0 0 12px rgba(13,148,136,.4);
    }
    .historia-step:hover .historia-text {
      transform: translateX(4px);
      transition: transform .2s ease;
    }

    @media (max-width: 960px) {
      .historia-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }
    @media (max-width: 640px) {
      .historia-col {
        padding: 1.8rem;
      }
      .historia-step {
        padding-left: 40px;
        margin-bottom: 1.8rem;
      }
      .historia-dot {
        width: 20px;
        height: 20px;
        left: 2px;
      }
      .historia-timeline::before {
        left: 9px;
      }
    }
  </style>
</head>
